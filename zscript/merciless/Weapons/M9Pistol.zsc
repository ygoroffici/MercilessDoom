
class BerettaM9 : Pistol replaces Pistol 
{
    Default
    {
		+Weapon.NOAUTOFIRE
        Weapon.WeaponScaleY 0.9;
		Weapon.WeaponScaleX 0.9;
        Weapon.BobRangeY 0.75;
        Weapon.BobRangeX 0.8;
        Weapon.BobStyle "Inverse";
        Weapon.BobSpeed 1.3;
    }

    States
    {
    Ready:
        M9PS A 1 A_WeaponReady();
        loop;
    Deselect:
        M9PS A 1 A_Lower(10);
        loop;
    Select:
        M9PS A 1 A_Raise(10);
        loop;
	Fire:
        // TODO:
        //  randomnly offset weapon left-right
        //  literally everything else here 
        TNT1 A 0 {
            A_FirePistol();
        }
		M9PF AB 1;
		// M9PF B 1;
		M9PF C 2;
		M9PF DE 1;
		Goto Ready;
	Flash:
        // TODO:
        //  multiple muzzleflash variants (randomnly chosen)
        //  smoke particle (maybe in Fire state)
		Goto LightDone;
    }
}