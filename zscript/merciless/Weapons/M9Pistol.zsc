
class BerettaM9 : MercilessWeapon replaces Pistol
{
    Default{
		+Weapon.NOAUTOFIRE
        +Weapon.WIMPY_WEAPON
        Weapon.SelectionOrder 1900;
        Weapon.AmmoUse 1;
        Weapon.AmmoGive 20;
        Weapon.AmmoType "Clip";
        Obituary "$OB_MPPISTOL";
        Inventory.PickupMessage "$PICKUP_PISTOL_DROPPED";
        Tag "$TAG_PISTOL";

        Weapon.WeaponScaleY 0.9;
		Weapon.WeaponScaleX 0.9;
        MercilessWeapon.VerticalRecoil 0.5;
        MercilessWeapon.HorizontalRecoil 0;
        MercilessWeapon.RecoilCrouchFactor 0;
        MercilessWeapon.AdsFactor 1.3;
    }


    action
    void MD_PistolFire()
    {
        double bullets, spreadX, spreadY, recoilZoomOut, heightOfs, smokeSize, smokeAlpha;
        if( invoker.isAiming )
        {
            bullets = -1;
            spreadX = 1.3;
            spreadY = 0;
            recoilZoomOut = invoker.ADSFactor - 0.02;
            heightOfs = 8;
            smokeSize = frandom[smk](0.10, 0.17);
            smokeAlpha = 0.75;
        }
        else
        {
            bullets = -1;
            spreadX = 2;
            spreadY = 0;
            recoilZoomOut = 0.98;
            heightOfs = 0;
            smokeSize = frandom[smk](0.08, 0.15);
            smokeAlpha = 0.85;
        }

        MD_FireWeapon(spreadX, spreadY, bullets, 7 * random(1,3));
        MD_SpawnBarrelSmoke(random(1,2), size:smokeSize, sizeStep:3, startAlpha:smokeAlpha, heightOfs);
        MD_ShakeCamera((0, 0.2, 0.4), 5, frandom[shk](0.0, 1.2)); // maybe change?
        A_ZoomFactor(recoilZoomOut);
        A_StartSound("weapons/m9/fire", CHAN_WEAPON, CHANF_OVERLAP, pitch:frandom(0.97, 1.03)); // placeholder sound...
    }


    States
    {
    Deselect:
        M9PS A 1 A_Lower(10);
        loop;
    Select:
        M9PS A 1 A_Raise(10);
        loop;

    //************************ READY STATES ************
    Ready:
        M9PS A 1 MD_WeaponReady();
        loop;
    AimReady:
        M9PZ D 1 MD_WeaponReady(WRF_NOBOB);
        loop;

    //************************ AIMING DOWN SIGHTS ************
    AltFire:
        M9PZ A 0 MD_DoAltfireZoom();
        goto AimBegin;
    AimBegin:
        M9PZ A 0 {
            A_ZoomFactor(invoker.ADSFactor);
            A_SetCrosshair(-1);
            A_OverlayPivot(OverlayID(), 0.51, 0.4); // wtf
        }
        M9PZ A 1;
        M9PZ BCD 1 {
            MD_SetYOffset(WEAPONTOP-2);
            MD_SetScale(1.15);
        }
        goto AimReady;
    AimStop:
        M9PZ DCBA 1 {
            MD_SetScale(1.0);
            MD_SetYOffset(WEAPONTOP);
            A_SetCrosshair(0);
            A_ZoomFactor(1.0);
        }
        goto Ready;

    //************************ FIRING STATES ************
	Fire:
        TNT1 A 0 { 
            if( invoker.isAiming ) {
                return ResolveState("AimFire");
            }
            return ResolveState(null);
        }
        M9PF A 1 {
            MD_PistolFire();
            A_WeaponOffset(0 + frandom[wpnoffs](-1.0, 1.0), WEAPONTOP, WOF_INTERPOLATE|WOF_KEEPY);
        }
		M9PF B 1 MD_MuzzleFlash();
        M9PF C 1 {
            A_ZoomFactor(1.0);
            MD_SpawnCasings("GenericCasing", -11.5, -15.5, 37.5, frandom(-1,3), frandom(2,5), frandom(1.5,3.5));
        }
        M9PF DEEFF 1 A_WeaponReady();
		Goto Ready;
    AimFire:
        M9ZF A 1 { 
            MD_PistolFire();
            A_WeaponOffset(0 + frandom[wpnoffs](-1.5, 1.5), WEAPONTOP - 3.2, WOF_INTERPOLATE);
        }
        M9ZF B 1 {
            MD_MuzzleFlash(-25.5, 1.75, 1.2);
            MD_SpawnCasings("GenericCasing", -10, -15.5, 41.5, frandom(-1,3), frandom(2,5), frandom(1.5,3.5));
        }
        M9ZF CC 1 {
            MD_AddToScale(0.07);
        }
        M9ZF DD 1 { 
            A_ZoomFactor(invoker.ADSFactor); 
            MD_SetScale();
            // MD_WeaponReady(WRF_NOBOB); 
        }
        TNT1 A 0 { 
            // Reset Y offset cuz WRF_NOBOB doesnt do it
            MD_SetYOffset();
        }
        goto AimReady;

    //************************ MUZZLE FLASHES ************
	MuzzleFlash:
        TNT1 A 0 {
            A_AttachLight('muzzlelight', DynamicLight.PointLight, color(255, 205, 205), 
                radius1: random(80,120), 
                radius2: 0,
                flags: DynamicLight.LF_ATTENUATE,
                ofs: (0,0,self.player.viewz)
                );
        }
        TNT1 A 0 A_Jump(256, "MuzzleFlash_Alt1", "MuzzleFlash_Alt2", "MuzzleFlash_Alt3");
        // TNT1 A 0 A_Jump(64, 2);
        // M9FF B 1 bright {
        //     A_OverlayRenderstyle(OverlayID(), STYLE_Add);
        //     A_OverlayOffset(OverlayID(), crandom2(3), 0);
        //     A_OverlayPivot(OverlayID(), 0.5, 0.5);
        //     A_OverlayScale(OverlayID(), frandom(0.75, 1.0), 0);
        //     A_OverlayRotate(OverlayID(), crandom2(8));
        // }
		// stop;
    MuzzleFlash_Alt1:
        M9FF AA 1 bright;
        goto FinishFlash;
    MuzzleFlash_Alt2:
        M9FF CB 1 bright;
        goto FinishFlash;
    MuzzleFlash_Alt3:
        M9FF DD 1 bright;
        goto FinishFlash;
    FinishFlash:
        TNT1 A 0 A_RemoveLight('muzzlelight');
        stop;
    Spawn:
        PIST A -1;
        Stop;
    }
}